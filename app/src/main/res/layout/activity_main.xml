<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:theme="@style/Theme.MyNewPlaylist">
    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorPrimary"
        android:orientation="vertical"

        app:layout_constraintTop_toTopOf="parent"
        >

        <TextView
            app:icon="@drawable/light_mode"
            app:iconGravity="textStart"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry"
            android:fontFamily="@font/ys_display_medium"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/search"
                android:text="@string/search"
                style="@style/ButtonViewMain"
                app:cornerRadius="@dimen/cornerRadius"
                app:icon="@drawable/light_mode"
                app:iconPadding="@dimen/padding"
                app:iconGravity="textStart"
                app:iconTint="@color/black"
                />

            <Button
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/media"
                android:text="@string/media_library"
                style="@style/ButtonViewMain"
                app:cornerRadius="@dimen/cornerRadius"
                app:icon="@drawable/light_mode2"
                app:iconPadding="@dimen/padding"
                app:iconGravity="textStart"
                app:iconTint="@color/black"

                />

            <Button
                android:fontFamily="@font/ys_display_medium"
                android:id="@+id/settings"
                android:text="@string/settings"
                style="@style/ButtonViewMain"
                app:cornerRadius="@dimen/cornerRadius"
                app:icon="@drawable/light_mode3"
                app:iconPadding="@dimen/padding"
                app:iconGravity="textStart"
                app:iconTint="@color/black"/>
        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>